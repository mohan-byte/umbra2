generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  name      String?
  role      String      @default("ANALYST")
  createdAt DateTime    @default(now())
  scans     Scan[]
  watchlist Watchlist[]
}

model Scan {
  id          String    @id @default(uuid())
  target      String
  targetType  String    // IP, DOMAIN, NETWORK
  status      String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  riskScore   Float?
  findings    Finding[]
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model Finding {
  id          String   @id @default(uuid())
  scanId      String
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title       String
  cveId       String?
  severity    String   // CRITICAL, HIGH, MEDIUM, LOW
  description String
  createdAt   DateTime @default(now())
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  indicator String   // The keyword, IP, or domain being watched
  type      String   // DARKWEB, CVE, ASSET
  createdAt DateTime @default(now())
}